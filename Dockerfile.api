# syntax=docker/dockerfile:1

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG BUILD_CONFIGURATION=Release

WORKDIR /source

COPY ["src/TFlexDrawingService.Core/TFlexDrawingService.Core.csproj", "src/TFlexDrawingService.Core/"]
COPY ["src/TFlexDrawingService.Infrastructure/TFlexDrawingService.Infrastructure.csproj", "src/TFlexDrawingService.Infrastructure/"]
COPY ["src/TFlexDrawingService.Api/TFlexDrawingService.Api.csproj", "src/TFlexDrawingService.Api/"]

COPY ["src/TFlexDrawingService.Core/", "src/TFlexDrawingService.Core/"]
COPY ["src/TFlexDrawingService.Infrastructure/", "src/TFlexDrawingService.Infrastructure/"]
COPY ["src/TFlexDrawingService.Api/", "src/TFlexDrawingService.Api/"]

RUN dotnet restore "src/TFlexDrawingService.Api/TFlexDrawingService.Api.csproj" \
        --force \
        --no-cache \
        --disable-parallel \
    && dotnet publish "src/TFlexDrawingService.Api/TFlexDrawingService.Api.csproj" \
        --configuration "$BUILD_CONFIGURATION" \
        --no-restore \
        --output /app/publish \
        /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
ARG APP_UID=1654

USER root
RUN apt-get update \
    && apt-get install --yes --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /workspace/storage /workspace/templates \
    && chown -R "$APP_UID:$APP_UID" /workspace

WORKDIR /app
COPY --from=build /app/publish .
COPY --chown=$APP_UID:$APP_UID ["templates/", "/workspace/templates/"]

ENV ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_ENVIRONMENT=Production \
    ASPNETCORE_URLS=http://+:8080 \
    Paths__ProjectRoot=/workspace

EXPOSE 8080
VOLUME ["/workspace/storage"]

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl --fail --silent --show-error http://127.0.0.1:8080/api/health/live || exit 1

USER $APP_UID
ENTRYPOINT ["dotnet", "TFlexDrawingService.Api.dll"]
